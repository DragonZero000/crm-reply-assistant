# OpenAI-совместимый API. По умолчанию — локальный LM Studio.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=lm-studio            # для OpenAI — реальный ключ, не коммитить
# LLM_MODEL=ornith-1.0-35b-mtp-apex
# LLM_MAX_TOKENS=8000
# LLM_TIMEOUT_SECONDS=300
# Повторы запроса к модели. 0 — без повторов: после таймаута медленной локальной модели
# повтор почти всегда снова упирается в таймаут. Для облачного провайдера разумно 1–2.
# LLM_MAX_RETRIES=0
# Цены за 1 млн токенов — только для оценки стоимости в логе (cost=…). Для локальной модели
# или модели на своих серверах не указывайте: в логе будет cost=n/a, токены пишутся всегда.
# LLM_PRICE_INPUT_PER_1M=
# LLM_PRICE_OUTPUT_PER_1M=
# HISTORY_LIMIT=10

# Адаптер AmoCRM: mock (по умолчанию, примечания в памяти, страница /mock) или amo.
# CRM_MODE=mock
# Токен вебхука: /webhooks/amo?token=<WEBHOOK_SECRET>. В режиме amo обязателен.
# WEBHOOK_SECRET=
# Только для CRM_MODE=amo: поддомен (demo → demo.amocrm.ru) и долгосрочный токен интеграции, не коммитить.
# AMO_SUBDOMAIN=
# AMO_ACCESS_TOKEN=
