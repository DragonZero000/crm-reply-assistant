{
  "version": "2026-09-30.3",
  "rules": [
    {
      "rule_id": "cure",
      "pattern": "\\b(вылеч|излеч)\\w*",
      "description": "Обещание вылечить / излечение"
    },
    {
      "rule_id": "treats",
      "pattern": "\\b(лечит|лечат|вылечивает|излечивает)\\b",
      "description": "Утверждение, что товар лечит"
    },
    {
      "rule_id": "rid_of",
      "pattern": "\\bизбав\\w*\\s+(\\w+\\s+)?от\\b",
      "description": "Обещание избавить от болезни или симптома"
    },
    {
      "rule_id": "helps_against",
      "pattern": "\\bпомо(жет|гает|гут|гают)\\s+(\\w+\\s+)?от\\b",
      "description": "«Поможет от …» — обещание действия против болезни или симптома"
    },
    {
      "rule_id": "against_disease",
      "pattern": "\\bот\\s+(бол(ь|и|ей|ях)\\b|болезн\\w*|заболеван\\w*|недуг\\w*|простуд\\w*|давлени\\w*|диабет\\w*|депресс\\w*|бессонниц\\w*)",
      "description": "Средство «от» болезни или симптома"
    },
    {
      "rule_id": "guarantee_effect",
      "pattern": "\\bгарантир\\w*\\s+(\\w+\\s+){0,2}(результат|эффект|выздоровлен|излечен|улучшен|иммунитет|здоров)\\w*",
      "description": "Гарантия результата или эффекта для здоровья"
    },
    {
      "rule_id": "replaces_medicine",
      "pattern": "\\bзамен\\w*\\s+(\\w+\\s+)?(лекарств|препарат|лечени|таблетк)\\w*",
      "description": "Утверждение, что товар заменяет лекарства или лечение"
    },
    {
      "rule_id": "immunity_boost",
      "pattern": "\\b(укреп|повы|усил|подн)\\w*\\s+(\\w+\\s+)?иммунитет\\w*",
      "description": "Обещание укрепить или повысить иммунитет"
    },
    {
      "rule_id": "hundred_percent",
      "pattern": "\\b100\\s*%\\s*(результат|эффект|гарант)\\w*",
      "description": "«100% результат/эффект»"
    },
    {
      "rule_id": "health_support",
      "pattern": "\\b(поддерж|укреп|улучш|сохран)\\w*\\s+(\\w+\\s+)?здоров\\w*",
      "description": "Обещание поддержать или улучшить здоровье"
    },
    {
      "rule_id": "relieves",
      "pattern": "\\b(сним|облегч|устран|уменьш)\\w*\\s+(\\w+\\s+)?(бол|воспален|спазм|симптом|отек)\\w*",
      "description": "Обещание снять или облегчить симптом"
    },
    {
      "rule_id": "helps_with_condition",
      "pattern": "\\bпомо(жет|гает|гут|гают)\\s+(\\w+\\s+)?при\\s+(\\w+\\s+){0,2}(бол|простуд|заболеван|артрит|артроз|гастрит|давлени|диабет|стресс|бессонниц|депресс|воспален)\\w*",
      "description": "«Поможет при …» болезни или симптоме"
    },
    {
      "rule_id": "healing_effect",
      "pattern": "\\b((лечебн|целебн|терапевтическ)\\w*\\s+(эффект|действи|свойств)|оздоров\\w*\\s+(\\w+\\s+)?(организм|тел))\\w*",
      "description": "Лечебный эффект или оздоровление организма"
    },
    {
      "rule_id": "normalizes",
      "pattern": "\\b(нормализ|снижа|сниз|понижа|пониз|регулир)\\w*\\s+(\\w+\\s+)?(давлени|холестерин|сахар|глюкоз)\\w*",
      "description": "Обещание нормализовать или снизить медицинский показатель"
    },
    {
      "rule_id": "effective_against",
      "pattern": "\\b(эффектив|действ)\\w*\\s+против\\b",
      "description": "«Эффективен против …» болезни"
    },
    {
      "rule_id": "for_treatment",
      "pattern": "\\bдля\\s+(лечени|профилактик)\\w*",
      "description": "Приём для лечения или профилактики"
    }
  ]
}
